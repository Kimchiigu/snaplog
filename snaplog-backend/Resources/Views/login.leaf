<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>SnapLog Admin – Login</title>
    <style>
        body { font-family: -apple-system, sans-serif; margin: 0; background: #f5f5f7; color: #1d1d1f; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .box { background: #fff; border-radius: 14px; padding: 2rem; width: 20rem; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
        h1 { font-size: 1.3rem; margin: 0 0 1rem; }
        label { display: block; margin-top: 0.7rem; font-size: 0.82rem; color: #555; }
        input { width: 100%; padding: 0.5rem; margin-top: 0.2rem; border: 1px solid #c7c7cc; border-radius: 6px; box-sizing: border-box; }
        button { margin-top: 1.1rem; width: 100%; padding: 0.55rem; border: none; border-radius: 6px; background: #007aff; color: #fff; cursor: pointer; font-size: 0.95rem; }
        .error { color: #ff3b30; font-size: 0.82rem; margin-top: 0.7rem; }
    </style>
</head>
<body>
    <div class="box">
        <h1>SnapLog Admin</h1>
        <form id="loginForm" method="POST" action="/admin/login">
            <label>Username <input type="text" name="username" autofocus required></label>
            <label>Password <input type="password" id="password" required></label>
            <input type="hidden" name="passwordHash" id="passwordHash">
            <button type="submit">Sign in</button>
            #if(error != ""):
            <div class="error">#(error)</div>
            #endif
        </form>
    </div>
    <script>
        document.getElementById("loginForm").onsubmit = async (e) => {
            const pw = document.getElementById("password");
            const hashField = document.getElementById("passwordHash");
            if (pw.value && !hashField.value) {
                e.preventDefault();
                const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(pw.value));
                hashField.value = Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, "0")).join("");
                pw.value = "";
                e.target.submit();
            }
        };
    </script>
</body>
</html>
