<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SnapLog Admin – #import("title")</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 0; background: #f5f5f7; color: #1d1d1f; }
        header { background: #1d1d1f; color: #fff; padding: 0.8rem 2rem; display: flex; align-items: center; justify-content: space-between; }
        header h1 { font-size: 1.15rem; margin: 0; }
        header nav a { color: #d1d1d6; margin-right: 1.1rem; text-decoration: none; font-size: 0.9rem; }
        header nav a:hover { color: #fff; }
        header form { margin: 0; }
        main { padding: 1.5rem 2rem; max-width: 72rem; margin: 0 auto; }
        h2 { font-size: 1.15rem; margin: 1.8rem 0 0.7rem; }
        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .card { background: #fff; border-radius: 12px; padding: 1rem 1.25rem; }
        .card .value { font-size: 1.9rem; font-weight: 700; }
        .card .label { font-size: 0.8rem; color: #86868b; text-transform: uppercase; letter-spacing: 0.04em; }
        table { border-collapse: collapse; width: 100%; background: #fff; border-radius: 10px; overflow: hidden; }
        th, td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid #e5e5ea; font-size: 0.88rem; vertical-align: middle; }
        th { background: #e8e8ed; }
        code { background: #e8e8ed; padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.8rem; }
        .empty { color: #86868b; font-style: italic; }
        .flash { background: #e8f5e9; border: 1px solid #a5d6a7; color: #1b5e20; border-radius: 8px; padding: 0.6rem 0.9rem; margin-bottom: 1rem; font-size: 0.88rem; }
        form.panel { background: #fff; padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.2rem; max-width: 32rem; }
        label { display: block; margin-top: 0.6rem; font-size: 0.82rem; color: #555; }
        input, select { width: 100%; padding: 0.4rem; margin-top: 0.2rem; border: 1px solid #c7c7cc; border-radius: 6px; }
        button { margin-top: 0.9rem; padding: 0.45rem 1.1rem; border: none; border-radius: 6px; background: #007aff; color: #fff; cursor: pointer; font-size: 0.88rem; }
        button.danger { background: #ff3b30; }
        button.ghost { background: #8e8e93; }
        .row-actions form { display: inline; }
        .row-actions button { margin: 0; padding: 0.25rem 0.7rem; font-size: 0.78rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; }
        .media-card { background: #fff; border-radius: 10px; overflow: hidden; }
        .media-card video, .media-card img { width: 100%; height: 11rem; object-fit: cover; background: #000; display: block; }
        .media-card .no-preview { height: 11rem; display: flex; align-items: center; justify-content: center; color: #86868b; background: #e8e8ed; font-size: 0.85rem; }
        .media-card .meta { padding: 0.6rem 0.8rem; font-size: 0.8rem; }
        .media-card .meta code { font-size: 0.72rem; word-break: break-all; }
        a { color: #007aff; }
    </style>
</head>
<body>
    <header>
        <h1>SnapLog Admin</h1>
        <nav>
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/rooms">Rooms</a>
            <a href="/admin/media">Media</a>
            <a href="/admin/upload-test">Upload Test</a>
            <form method="POST" action="/admin/logout"><button class="ghost" type="submit">Log out</button></form>
        </nav>
    </header>
    <main>
        #import("body")
    </main>
</body>
</html>
