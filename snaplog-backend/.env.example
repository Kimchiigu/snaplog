# Server
PORT=8080
ENVIRONMENT=development

# Database (NeonDB Remote PostgreSQL)
DATABASE_URL=postgres://<user>:<password>@<neondb-hostname>/snaplog_db?sslmode=require

# Redis (Local Docker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=local_redis_pass

# Cloudflare R2 (S3-Compatible Object Storage)
R2_ACCOUNT_ID=<cloudflare_account_id>
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_BUCKET_NAME=snaplog-media-dev
R2_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com

# JWT session token secret
JWT_SECRET=<random-long-string>

# Apple Sign-In validation
APPLE_WEB_AUTH_KEY=<apple_key_from_developer_portal>
APPLE_TEAM_ID=<apple_team_id>
APPLE_BUNDLE_ID=<app_bundle_id>

# --- Architecture hardening ---
# Per-pod Postgres pool size (per event loop). With HPA 2-10 pods prefer
# Neon's pooled connection string (-pooler suffix) as DATABASE_URL.
POSTGRES_MAX_CONNECTIONS=1

# Shared secret for POST /webhooks/r2-upload-complete (R2 Event Notifications).
# Unset = endpoint returns 503.
R2_WEBHOOK_SECRET=<random-string>
# Public base URL of the R2 bucket (or custom domain) for moderation checks.
R2_PUBLIC_BASE_URL=https://media.example.com

# Content moderation endpoint (POST {s3Key,url} -> {approved,reason}).
# Unset = moderation passes with a notice; errors fail closed (rejected).
MODERATION_URL=

# APNs push (unset = pushes are logged only, no sends).
APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=<10-char-key-id>
APNS_TEAM_ID=<apple-team-id>
APNS_ENVIRONMENT=sandbox
APNS_TOPIC=<app-bundle-id>
