 "cards": [
  {
   "dot": "cyan",
   "title": "Edge",
   "items": [
    "ngrok is the public gateway; it sends app traffic to Caddy",
    "Caddy sends the traffic on to the app on :8080",
    "The app uploads each clip direct to R2 with a presigned PUT"
   ]
  },
  {
   "dot": "emerald",
   "title": "Application",
   "items": [
    "Vapor serves the REST API, the admin pages, and the room WebSocket",
    "Redis holds the job queues, the room events, the timeline cache, and the idempotency keys",
    "The worker makes the day video with FFmpeg, away from the request path",
    "PostgreSQL runs outside the host; the app reaches it with DATABASE_URL"
   ]
  },
  {
   "dot": "rose",
   "title": "Push",
   "items": [
    "When a new log comes in, APNs tells each room member except the sender",
    "When the day video is complete, the worker sends a digest alert",
    "Each POST request sends an idempotency key; Redis keeps it for 24 hours",
    "APNs wakes the app when an alert arrives"
   ]
  }
 ]
}